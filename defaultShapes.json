{
  "square": {
    "formula": "x**2",
    "number of inputs": 1,
    "name for the inputs": ["Side"],
    "formula type": "Area"
  },

  "rectangle": {
    "formula": "x * y",
    "number of inputs": 2,
    "name for the inputs": ["Length", "Width"],
    "formula type": "Area"
  },

  "triangle": {
    "formula": ".5 * x * y",
    "number of inputs": 2,
    "name for the inputs": ["Base", "Hight"],
    "formula type": "Area"
  },

  "circle": {
      "formula": "3.141* (.5 * x)",
      "number of inputs": 1,
      "name for the inputs": ["Diameter"],
      "formula type": "Area"
    
  },

  "annulus": 
  {
    "formula": "3.141 * (x + y)",
    "number of inputs": 2,
    "name for the inputs": ["Radius 1", "Radius 2"],
    "formula type": "Area"
  },

  "cube": 
  {
    "formula": "x**3",
    "number of inputs": 1,
    "name for the inputs": ["Side"],
    "formula type": "Volume"
  },

 "rectangular prism": 
 {
    "formula": "(x * y) * z",
    "number of inputs": 3,
    "name for the inputs": ["Base length", "Base width", "Height"],
    "formula type": "Volume"
 },

 "sphere":
 {
    "formula": "(4/3) * 3.141 * x**3",
    "number of inputs": 1,
    "name for the inputs": ["Radius"],
    "formula type": "Volume"
 },

 "cone":
 {
    "formula": "(1/3) * 3.141 * x**2 * y",
    "number of inputs": 2,
    "name for the inputs": ["Radius", "Height"],
    "formula type": "Volume"
 },

 "right circular cylinder":
 {
    "formula": "3.141 * x**2 *y",
    "number of inputs": 2,
    "name for the inputs": ["Radius", "Height"],
    "formula type": "Volume"
 }
}